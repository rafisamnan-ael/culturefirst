# ---------------------------------------------------------------------------
# CultureFirst environment variables
# Copy to .env.local and fill in. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# Public Supabase configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical site URL (no trailing slash). localhost in dev, real domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brand configuration (centralised - change name/tagline without code edits)
NEXT_PUBLIC_BRAND_NAME=CultureFirst
NEXT_PUBLIC_BRAND_TAGLINE=Know the culture before you choose.

# ---------------------------------------------------------------------------
# SERVER-ONLY variables. Never prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Service role key - used only by trusted server-side operations (moderation,
# aggregation, admin). Required in production. Leave blank for dev fixtures.
SUPABASE_SERVICE_ROLE_KEY=

# Data source: "supabase" (production) or "fixtures" (local development only).
# When "fixtures", clearly-labelled sample data is used and mutations are
# stored in a local JSON file. NEVER use "fixtures" in production.
DATA_SOURCE=fixtures

# Dev auth: when DATA_SOURCE=fixtures, allows a local cookie session so the
# review/moderation/admin flows can be exercised without Supabase. NEVER true
# in production.
DEV_AUTH=true

# Moderation / scoring thresholds (override platform_settings defaults)
SCORE_MIN_ANSWERED_PARAMETERS=3
SCORE_MIN_WEIGHT_COVERAGE=0.6
AGG_MIN_PROVISIONAL=5
AGG_MIN_PUBLISHED=20
